# ---------- Servidor ----------
PORT=3000

# ---------- Base de datos MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bdtienda_zapatos
# Ponlo en true si tu MySQL en la nube exige conexión SSL
DB_SSL=false

# ---------- Seguridad ----------
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=root
JWT_EXPIRES_IN=8h

# ---------- Conexión con el frontend (CORS) ----------
# URL(s) del frontend SIN "/" al final, separadas por coma.
# Local:       http://localhost:5173
# Producción:  https://tu-tienda.vercel.app
CORS_ORIGIN=http://localhost:5173

# ---------- Solo para `npm run seed` ----------
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=Admin12345
# false = no crear categorías/productos de ejemplo (recomendado en producción)
SEED_EJEMPLOS=true
